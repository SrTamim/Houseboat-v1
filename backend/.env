# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Database (PostgreSQL 17, local) ───────────────────
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/houseboat?schema=public

# ── Redis (optional in early dev; app boots without it) ─
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=dev-change-me-0e94ad-long-random-string-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-change-me-refresh-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
CSRF_SECRET=dev-change-me-csrf-secret-32-bytes-min-ok
# App-layer PII encryption (refund bank details). 32+ chars in production.
ENCRYPTION_KEY=9604687d56f60ae36f0070aaa2ca297d969e4d493b536bbc2881bc9f3fccaff8
COOKIE_SECURE=false

# ── Object storage (S3 / Cloudflare R2) — fill later ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=houseboat
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Web Push (VAPID) — fill later ─────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Public URLs (gateway redirects, IPN, e-ticket links) ──
API_PUBLIC_URL=http://localhost:4000

# API docs at /api/docs. On by default in dev; set true to expose in prod.
SWAGGER_ENABLED=false

# ── Payment gateway (SSLCommerz — Bangladesh) — fill later ──
GATEWAY_PROVIDER=sslcommerz
SSLCZ_SANDBOX=true
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
PAYMENTS_BYPASS=true

# ── Notifications: SMS (BD) + Email (SMTP) — fill later ──
SMS_API_URL=https://sms.onecodesoft.com/api/send-sms
SMS_API_KEY=s0agDQmjs4uSTcu3ACSOoowWDQi1wNJWnxviw0GJ
SMS_SENDER_ID=8809617626047
SMTP_URL=
EMAIL_FROM=no-reply@houseboat.local

# Migration/owner role (DDL). See .env.example.
DIRECT_DATABASE_URL=postgresql://postgres:admin123@localhost:5432/houseboat?schema=public

# Platform admin seed (maker/checker pair) — local dev only.
ADMIN_PHONE=+8801700000000
ADMIN_PASSWORD=localdev-admin-pass
ADMIN2_PHONE=+8801700000001
ADMIN2_PASSWORD=localdev-admin2-pass

# Demo boat owner (owner console login)
OWNER_PHONE=+8801700000002
OWNER_PASSWORD=localdev-owner-pass
