// ============================================================
//  Houseboat SaaS — Prisma schema
//  Translated from plan/houseboat (1).dbml (41 tables, 7 modules).
//
//  Conventions:
//   - All PKs are uuid, generated app-side as UUIDv7 (time-ordered,
//     non-enumerable) — see src/common/uuid.ts. We pass the id in on
//     create rather than using dbDefault so we control v7.
//   - All money is Decimal(12,2). Never Float.
//   - All timestamps are stored UTC (DateTime @db.Timestamptz).
//   - status/kind/state fields are varchar today; can tighten to
//     Postgres enums later without a data change.
//
//  CONSTRAINTS PRISMA CANNOT EXPRESS live in a raw-SQL migration
//  (prisma/migrations/*_constraints/). Namely:
//    - cabin_hold  partial unique index (cabin_id, departure_id) WHERE state='held'
//    - booking_cabin active-row uniqueness on the cabin per departure
//    - houseboat_member  uq_member_active partial unique (account_id, houseboat_id)
//        WHERE status='active' — a person is a member of a boat once while active
//    - audit_log    append-only trigger (no UPDATE/DELETE) + monthly partitions
//    - pricing_profile GIN index on dates[]
//  See that migration for the authoritative DDL.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. Should be a non-superuser role with CRUD and no DDL —
  // a superuser can DROP the append-only audit trigger. See .env.example.
  url      = env("DATABASE_URL")
  // Migrations need DDL (and a non-pooled connection when using pgbouncer),
  // so they run as a separate owner role.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------- PLATFORM SETTINGS ----------

/// Runtime-editable operational settings, as typed key→value rows.
///
/// Every value has a compiled-in default (see src/platform/settings/setting-defs.ts);
/// a row here only exists once an admin overrides that default. Code reads through
/// SettingsService, which falls back to the default when no row is present — so an
/// empty table reproduces today's hardcoded behaviour exactly. `value` is stored as
/// text and parsed per the setting's declared type (integer today).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("app_setting")
}

// ---------- IDENTITY, RBAC & AUDIT ----------

/// One login per person. A single human can be a customer, an owner
/// (via HouseboatMember) AND crew (via HouseboatStaff) at once.
model Account {
  id            String   @id @db.Uuid
  name          String?
  email         String?
  phone         String   @unique
  passwordHash  String?  @map("password_hash")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  /// Customer's national ID / passport. Plaintext, not a secret — the customer,
  /// boat owner and admin all need to read it (e.g. ghat verification).
  nid           String?
  /// true = platform admin/finance staff. NO type enum: what a person IS derives from relations.
  isPlatform    Boolean  @default(false) @map("is_platform")
  /// NULL on a platform account = unrestricted superadmin. Only meaningful when is_platform.
  platformRoleId String? @map("platform_role_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships          HouseboatMember[]
  staffRoles           HouseboatStaff[]
  auditLogs            AuditLog[]
  bookingsAsCustomer   Booking[]                @relation("BookingCustomer")
  bookingsBooked       Booking[]                @relation("BookingBookedBy")
  holds                CabinHold[]
  waitlists            BookingWaitlist[]
  quoteRequests        QuoteRequest[]
  invoices             Invoice[]
  paymentsReceived     InvoicePayment[]         @relation("PaymentReceivedBy")
  paymentsVerified     InvoicePayment[]         @relation("PaymentVerifiedBy")
  refundsRequested     InvoiceRefund[]          @relation("RefundRequestedBy")
  refundsVerified      InvoiceRefund[]          @relation("RefundVerifiedBy")
  refundsCompleted     InvoiceRefund[]          @relation("RefundCompletedBy")
  payoutsPrepared      HouseboatPayoutBatch[]   @relation("PayoutPreparedBy")
  payoutsApproved      HouseboatPayoutBatch[]   @relation("PayoutApprovedBy")
  payoutsPaid          HouseboatPayoutBatch[]   @relation("PayoutPaidBy")
  distributionsRecorded OwnerDistribution[]
  credits              CustomerCredit[]
  cashoutRequests      CashoutRequest[]         @relation("CashoutRequester")
  cashoutsResolved     CashoutRequest[]         @relation("CashoutResolvedBy")
  payrollPaid          StaffPayroll[]
  costsPaid            Cost[]
  stockLogged          StockMovement[]
  reviews              Review[]
  notifications        Notification[]
  // Restrict, not the default SetNull: deleting a role must not silently
  // promote its assigned staff to unrestricted superadmin.
  platformRole         PlatformRole?            @relation(fields: [platformRoleId], references: [id], onDelete: Restrict)

  @@index([platformRoleId])
  @@map("account")
}

/// Granular permissions for PLATFORM staff (console sections), separate from
/// the per-boat Role model. Accounts with is_platform and a NULL role are
/// unrestricted superadmins — see platform/rbac/platform-permission.guard.ts.
model PlatformRole {
  id          String   @id @db.Uuid
  name        String   @unique
  /// {module:{view:bool,edit:bool}} over PLATFORM_MODULES — validated in
  /// platform/rbac/platform-permission.types.ts, never trusted raw.
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  accounts Account[]

  @@map("platform_role")
}

/// Per-boat permissions. Same person can be admin on one boat, restricted shareholder on another.
model HouseboatMember {
  id             String    @id @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  houseboatId    String    @map("houseboat_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  /// record only — no auto profit-split
  shareholderPct Decimal?  @map("shareholder_pct") @db.Decimal(5, 2)
  startDate      DateTime? @map("start_date") @db.Date
  /// null = current; set on exit, keeps historical read access
  endDate        DateTime? @map("end_date") @db.Date
  /// active / exited
  status         String    @default("active")
  /// per-boat notification preferences: {"booking":true,"payment_due":true,…}
  notificationPrefs Json? @map("notification_prefs")

  account   Account   @relation(fields: [accountId], references: [id])
  houseboat Houseboat @relation(fields: [houseboatId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])
  distributions OwnerDistribution[]

  @@index([accountId])
  @@index([houseboatId])
  @@map("houseboat_member")
}

model Role {
  id          String  @id @db.Uuid
  houseboatId String  @map("houseboat_id") @db.Uuid
  /// owner-named via role generator: Owner, Shareholder, Manager…
  name        String
  isTemplate  Boolean @default(false) @map("is_template")
  /// per-module view/edit map: {"bookings":{"view":true,"edit":false},…} — read as a unit at login
  permissions Json?

  houseboat Houseboat         @relation(fields: [houseboatId], references: [id])
  members   HouseboatMember[]
  staff     HouseboatStaff[]

  @@index([houseboatId])
  @@map("role")
}

/// APPEND-ONLY. No UPDATE/DELETE — enforced by DB trigger. Also the offline-sync replay store.
/// Partitioned by month. Replayed actions re-authorized against permissions as of device_time.
model AuditLog {
  /// Partitioned by month on server_time — the PK must include the partition key.
  id             String   @db.Uuid
  /// null for platform-level actions
  houseboatId    String?  @map("houseboat_id") @db.Uuid
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  /// mark_paid, void, price_change, role_change…
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  /// mask PII — store refs not raw bank details
  before         Json?
  after          Json?
  /// clock on the device — may be manipulated
  deviceTime     DateTime? @map("device_time") @db.Timestamptz
  /// authoritative
  serverTime     DateTime  @default(now()) @map("server_time") @db.Timestamptz
  syncedOffline  Boolean   @default(false) @map("synced_offline")
  /// request origin — without these an audit row can't answer "who, from where"
  ip             String?   @db.Inet
  userAgent      String?   @map("user_agent")

  houseboat Houseboat? @relation(fields: [houseboatId], references: [id])
  actor     Account?   @relation(fields: [actorAccountId], references: [id])

  @@id([id, serverTime])
  @@index([houseboatId])
  @@index([entityType, entityId])
  // The boat audit trail + dashboard recent-activity read WHERE houseboatId
  // ORDER BY serverTime DESC (keyset). Matches that order so the fast-growing,
  // month-partitioned table doesn't scan+sort per page.
  @@index([houseboatId, serverTime(sort: Desc)])
  @@map("audit_log")
}

// ---------- HOUSEBOAT ASSETS ----------

model Houseboat {
  id                String    @id @db.Uuid
  name              String
  /// public URL: /houseboat/[slug]
  slug              String    @unique
  description       String?
  safetyFeatures    String?   @map("safety_features")
  /// owner-entered free text shown in the customer cabin modal → Policies tab
  cancellationPolicy String?  @map("cancellation_policy")
  /// { breakfast, brunch, lunch, snacks, dinner } — separate meal inputs
  foodMenu          Json?     @map("food_menu")
  /// MANDATORY before any payout can run
  bankAccount       Json?     @map("bank_account")
  /// reaches 100 → admin can approve
  profileCompletePct Int      @default(0) @map("profile_complete_pct")
  /// draft / pending / live / suspended
  status            String    @default("draft")
  billingConfigId   String?   @map("billing_config_id") @db.Uuid
  /// only these dates generate bookable departures
  operatingDates    DateTime[] @map("operating_dates") @db.Date
  /// staff ids auto-assigned to every new departure
  defaultCrew       String[]  @map("default_crew") @db.Uuid
  /// age bands: [{min,max,charge_pct}]
  childPolicy       Json?     @map("child_policy")
  /// R2 key for the boat logo (square WebP); public URL via StorageService
  logoStorageKey    String?   @map("logo_storage_key")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // ── Denormalized search facets ──────────────────────────────────────────
  // Rolled up from the default pricing profile's rules, cabin categories, and
  // non-hidden reviews so /houseboats/search can filter/sort/paginate in the DB
  // instead of reading the whole live catalogue per request. Kept fresh by
  // HouseboatFacetsService.recompute() on every mutation that changes them, plus
  // a nightly backstop cron. NULL price/rating mean "no priced rules / no
  // reviews" (same semantics search() had when it computed these per request).
  /// min per-person price across the boat's default profile rules; NULL = unpriced
  minPricePerPerson Decimal? @map("min_price_per_person") @db.Decimal(12, 2)
  /// max party size across cabin categories (extended ?? base)
  maxCapacity       Int      @default(0) @map("max_capacity")
  hasAc             Boolean  @default(false) @map("has_ac")
  hasNonAc          Boolean  @default(false) @map("has_non_ac")
  /// mean of non-hidden review ratings; NULL = no reviews
  ratingAvg         Float?   @map("rating_avg")
  reviewCount       Int      @default(0) @map("review_count")
  /// lowercased, space-joined rollup of cabin-category facilities, for amenity `contains`
  amenitiesText     String?  @map("amenities_text")

  billingConfig        HouseboatBillingConfig?       @relation("HouseboatBillingConfig", fields: [billingConfigId], references: [id])
  members              HouseboatMember[]
  roles                Role[]
  auditLogs            AuditLog[]
  decks                HouseboatDeck[]
  cabinCategories      HouseboatCabinCategory[]
  routes               HouseboatRoute[]
  tripPackages         TripPackage[]
  schedules            BoatSchedule[]
  pricingProfiles      PricingProfile[]
  groupPriceBands      GroupPriceBand[]
  quoteRequests        QuoteRequest[]
  invoices             Invoice[]
  cancellationPolicies CancellationPolicy[]
  coupons              Coupon[]
  billingConfigs       HouseboatBillingConfig[]      @relation("BillingConfigOwner")
  subscriptionInvoices HouseboatSubscriptionInvoice[]
  payoutBatches        HouseboatPayoutBatch[]
  ownerDistributions   OwnerDistribution[]
  staff                HouseboatStaff[]
  costs                Cost[]
  inventoryItems       InventoryItem[]
  reviews              Review[]
  media                HouseboatMedia[]
  maintenanceRequests  MaintenanceRequest[]

  // Search reads WHERE status='live' then filters/sorts on the denormalized
  // facets; these composite indexes back each supported sort + range filter.
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, minPricePerPerson])
  @@index([status, ratingAvg])
  @@index([status, reviewCount])
  @@map("houseboat")
}

model HouseboatDeck {
  id          String @id @db.Uuid
  houseboatId String @map("houseboat_id") @db.Uuid
  /// Lower, Upper
  name        String
  position    Int    @default(0)

  houseboat Houseboat        @relation(fields: [houseboatId], references: [id])
  cabins    HouseboatCabin[]

  @@index([houseboatId])
  @@map("houseboat_deck")
}

model HouseboatCabin {
  id             String @id @db.Uuid
  deckId         String @map("deck_id") @db.Uuid
  cabinCategoryId String @map("cabin_category_id") @db.Uuid
  /// 101, 102
  name           String
  /// auto-generated 2x2 grid; not a positioning builder
  gridRow        Int?   @map("grid_row")
  gridCol        Int?   @map("grid_col")

  deck     HouseboatDeck          @relation(fields: [deckId], references: [id])
  category HouseboatCabinCategory @relation(fields: [cabinCategoryId], references: [id])
  bookingCabins BookingCabin[]
  waitlists     BookingWaitlist[]
  holds    CabinHold[]
  media    HouseboatMedia[]

  @@index([deckId])
  @@index([cabinCategoryId])
  @@map("houseboat_cabin")
}

model HouseboatCabinCategory {
  id               String  @id @db.Uuid
  houseboatId      String  @map("houseboat_id") @db.Uuid
  /// Luxury AC, Family…
  name             String
  isAc             Boolean @default(false) @map("is_ac")
  baseCapacity     Int     @map("base_capacity")
  /// group-booking overflow, owner-set
  extendedCapacity Int?    @map("extended_capacity")
  facilities       String?

  houseboat    Houseboat        @relation(fields: [houseboatId], references: [id])
  cabins       HouseboatCabin[]
  pricingRules PricingRule[]

  @@index([houseboatId])
  @@map("houseboat_cabin_category")
}

/// Admin-managed. Owners pick from these; they cannot create routes.
model Route {
  id     String  @id @db.Uuid
  /// Tanguar Haor, Nikli Haor… PLATFORM-curated
  name   String
  region String?
  active Boolean @default(true)

  houseboatRoutes HouseboatRoute[]
  tripPackages    TripPackage[]
  pricingProfiles PricingProfile[]

  @@map("route")
}

/// Many-to-many: which boats run which routes.
model HouseboatRoute {
  id          String @id @db.Uuid
  houseboatId String @map("houseboat_id") @db.Uuid
  routeId     String @map("route_id") @db.Uuid

  houseboat Houseboat @relation(fields: [houseboatId], references: [id])
  route     Route     @relation(fields: [routeId], references: [id])

  @@unique([houseboatId, routeId])
  @@map("houseboat_route")
}

// ---------- TRIPS, SCHEDULE & PRICING ----------

/// A boat's recurring weekly schedule. The owner picks a package (which carries
/// the route) and up to 3 trip slots, each with its own weekdays. A generator
/// auto-creates trip_departure rows for a rolling window ahead; a daily cron
/// keeps ~60 days populated. One active schedule per boat.
model BoatSchedule {
  id          String   @id @db.Uuid
  houseboatId String   @map("houseboat_id") @db.Uuid
  /// the package to generate departures from — its route is the boat's route
  packageId   String   @map("package_id") @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  houseboat Houseboat           @relation(fields: [houseboatId], references: [id])
  package   TripPackage         @relation(fields: [packageId], references: [id])
  slots     TripScheduleSlot[]

  @@index([houseboatId])
  @@map("boat_schedule")
}

/// One trip slot in a weekly schedule (Trip 1/2/3). weekdays: 0=Sun … 6=Sat.
model TripScheduleSlot {
  id               String   @id @db.Uuid
  scheduleId       String   @map("schedule_id") @db.Uuid
  /// 1..7 — up to one trip per weekday
  slotNo           Int      @map("slot_no")
  /// selected days of week, 0=Sun … 6=Sat
  weekdays         Int[]
  departureTime    DateTime? @map("departure_time") @db.Time
  pricingProfileId String?  @map("pricing_profile_id") @db.Uuid

  schedule   BoatSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  departures TripDeparture[]

  @@unique([scheduleId, slotNo])
  @@index([scheduleId])
  @@map("trip_schedule_slot")
}

model TripPackage {
  id                   String  @id @db.Uuid
  houseboatId          String  @map("houseboat_id") @db.Uuid
  routeId              String  @map("route_id") @db.Uuid
  /// 1 = day trip, 2 = 2 days 1 night — shown on boat cards instead of times
  durationDays         Int     @map("duration_days")
  /// display text: "2 days 1 night"
  durationLabel        String? @map("duration_label")
  departureGhat        String? @map("departure_ghat")
  returnGhat           String? @map("return_ghat")
  meals                String?
  included             String?
  excluded             String?
  cancellationPolicyId String? @map("cancellation_policy_id") @db.Uuid

  houseboat          Houseboat           @relation(fields: [houseboatId], references: [id])
  route              Route               @relation(fields: [routeId], references: [id])
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  departures         TripDeparture[]
  schedules          BoatSchedule[]

  @@index([houseboatId])
  @@map("trip_package")
}

model TripDeparture {
  id               String    @id @db.Uuid
  packageId        String    @map("package_id") @db.Uuid
  /// multi-day trips MUST be booked on the start date
  startDate        DateTime  @map("start_date") @db.Date
  /// start_date + duration_days - 1
  endDate          DateTime? @map("end_date") @db.Date
  /// shown on the boat page, not on search cards
  departureTime    DateTime? @map("departure_time") @db.Time
  arrivalTime      DateTime? @map("arrival_time") @db.Time
  pricingProfileId String?   @map("pricing_profile_id") @db.Uuid
  /// set when auto-generated from a weekly schedule slot — enables per-slot dedupe
  scheduleSlotId   String?   @map("schedule_slot_id") @db.Uuid
  /// DENORMALIZED cabin availability — updated transactionally on every hold/release/booking
  availableCount   Int       @default(0) @map("available_count")
  /// scheduled / in_progress / completed / cancelled — time-driven, UTC
  status           String    @default("scheduled")
  /// owner-supplied reason when status='cancelled' — shown to customers for refund requests
  cancelReason     String?   @map("cancel_reason")
  /// when the owner cancelled this departure — anchors the customer's 6-day refund-request window; nulled on revive
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz

  package        TripPackage       @relation(fields: [packageId], references: [id])
  pricingProfile PricingProfile?   @relation(fields: [pricingProfileId], references: [id])
  scheduleSlot   TripScheduleSlot? @relation(fields: [scheduleSlotId], references: [id])
  bookings       Booking[]
  holds          CabinHold[]
  waitlists      BookingWaitlist[]
  crew           TripCrew[]
  costs          Cost[]
  stockMovements StockMovement[]

  @@index([packageId])
  @@index([startDate])
  @@index([status])
  @@index([scheduleSlotId])
  // Reports, dashboard, calendar and availability all filter departures by
  // package + date range (and often status). The single-column indexes above
  // can't serve the combined predicate; these composites do.
  @@index([packageId, startDate])
  @@index([packageId, status])
  @@map("trip_departure")
}

model PricingProfile {
  id          String     @id @db.Uuid
  houseboatId String     @map("houseboat_id") @db.Uuid
  /// route this profile prices; null for legacy/free-form profiles (schedule page)
  routeId     String?    @map("route_id") @db.Uuid
  /// general | weekend | holiday for route pricing; null for legacy/free-form profiles
  priceType   String?    @map("price_type")
  /// General Day, Weekend, Eid, Full Moon
  name        String
  /// General Day = base/fallback
  isDefault   Boolean    @default(false) @map("is_default")
  /// dates this profile applies to; null/empty for the default. GIN-indexed (raw-SQL migration).
  dates       DateTime[] @db.Date

  houseboat  Houseboat       @relation(fields: [houseboatId], references: [id])
  route      Route?          @relation(fields: [routeId], references: [id])
  rules      PricingRule[]
  departures TripDeparture[]

  @@index([houseboatId])
  @@index([routeId])
  @@map("pricing_profile")
}

/// Each profile owns a FULL independent price table — not a multiplier on a base.
model PricingRule {
  id              String  @id @db.Uuid
  pricingProfileId String @map("pricing_profile_id") @db.Uuid
  cabinCategoryId String  @map("cabin_category_id") @db.Uuid
  /// 2, 3, 4… per-person price varies by how many share
  occupancy       Int
  pricePerPerson  Decimal @map("price_per_person") @db.Decimal(12, 2)

  profile  PricingProfile         @relation(fields: [pricingProfileId], references: [id])
  category HouseboatCabinCategory @relation(fields: [cabinCategoryId], references: [id])

  @@unique([pricingProfileId, cabinCategoryId, occupancy])
  @@map("pricing_rule")
}

model GroupPriceBand {
  id          String  @id @db.Uuid
  houseboatId String  @map("houseboat_id") @db.Uuid
  minPeople   Int     @map("min_people")
  maxPeople   Int     @map("max_people")
  /// full-boat buyout; customer picks band then types headcount
  totalPrice  Decimal @map("total_price") @db.Decimal(12, 2)

  houseboat Houseboat @relation(fields: [houseboatId], references: [id])

  @@index([houseboatId])
  @@map("group_price_band")
}

// ---------- BOOKINGS, HOLDS & WAITLIST ----------

model Booking {
  id                  String   @id @db.Uuid
  departureId         String   @map("departure_id") @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  /// owner in POS mode, else the customer
  bookedBy            String   @map("booked_by") @db.Uuid
  /// cabin / group / quote
  type                String
  /// booking origin — 'web' = customer self-service (platform earns commission),
  /// 'pos' = owner counter sale (NO commission). Immutable, set at creation.
  channel             String   @default("web")
  headcount           Int?
  specialInstructions String?  @map("special_instructions")
  couponId            String?  @map("coupon_id") @db.Uuid
  /// free text, optional — who referred/sent the customer
  referenceName       String?  @map("reference_name")
  /// confirmed / cancelled / not_arrived / completed
  /// (legacy 'rescheduled' rows may still exist; the reschedule feature is retired)
  status              String   @default("confirmed")
  /// departure attendance, owner-set on the manifest: pending / checked_in / absent
  checkinStatus       String   @default("pending") @map("checkin_status")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  departure  TripDeparture @relation(fields: [departureId], references: [id])
  customer   Account       @relation("BookingCustomer", fields: [customerId], references: [id])
  bookedByAccount Account  @relation("BookingBookedBy", fields: [bookedBy], references: [id])
  coupon     Coupon?       @relation(fields: [couponId], references: [id])
  cabins     BookingCabin[]
  guests     BookingGuest[]
  invoice    Invoice?
  review     Review?

  @@index([departureId])
  @@index([customerId])
  @@index([status])
  @@index([channel])
  @@map("booking")
}

/// ENFORCE unique (cabin_id, departure via booking) among ACTIVE rows — DB-level, not app code.
model BookingCabin {
  id         String  @id @db.Uuid
  bookingId  String  @map("booking_id") @db.Uuid
  cabinId    String  @map("cabin_id") @db.Uuid
  /// chosen at the ROOM SELECTION step — this is what sets the price
  adults     Int
  /// charged per houseboat.child_policy
  children   Int     @default(0)
  /// adults + children — must not exceed capacity (or extended for groups)
  occupancy  Int
  /// owner-set price for this many people in this room; not calculated
  roomPrice  Decimal @map("room_price") @db.Decimal(12, 2)
  /// leftover shared inventory — spare place bookable by another party
  isOpenSeat Boolean @default(false) @map("is_open_seat")

  booking Booking        @relation(fields: [bookingId], references: [id])
  cabin   HouseboatCabin @relation(fields: [cabinId], references: [id])

  @@index([bookingId])
  @@index([cabinId])
  @@map("booking_cabin")
}

/// Only the lead guest is recorded by name. Head counts live on booking_cabin.
model BookingGuest {
  id        String @id @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  /// lead guest only — captured at checkout for contact
  name      String
  phone     String?
  /// Lead-guest contact email for the voucher. Plaintext (a contact address,
  /// not an identity document) and per-booking, since the booker is often not
  /// the traveller.
  email     String?
  /// National ID / passport, encrypted at rest (AES-256-GCM, common/crypto.ts).
  /// Ciphertext only — never returned in list responses, redacted in logs.
  nidEncrypted String? @map("nid_encrypted")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("booking_guest")
}

/// ENFORCE partial unique index on (cabin_id, departure_id) WHERE state='held'.
/// The second simultaneous tap fails at the DB. This kills double-booking.
model CabinHold {
  id          String   @id @db.Uuid
  cabinId     String   @map("cabin_id") @db.Uuid
  departureId String   @map("departure_id") @db.Uuid
  /// Account owner. NULL when a signed-out visitor took the hold — then
  /// heldByToken identifies the browser instead. Exactly one of the two is set
  /// (CHECK cabin_hold_one_owner).
  heldBy      String?  @map("held_by") @db.Uuid
  /// Guest owner: opaque per-browser id from the hb_gid cookie. Claimed onto an
  /// account at login so checkout can convert the hold.
  heldByToken String?  @map("held_by_token")
  /// 10-min TTL; server clock authoritative, not the device
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  /// When the one-and-only checkout extension (+10 min) was granted. NULL =
  /// never extended. Server-side so reloading checkout cannot stack more time.
  extendedAt  DateTime? @map("extended_at") @db.Timestamptz
  /// Last heartbeat from the page holding this cabin. The sweeper reclaims a
  /// hold that stops reporting, so closing a tab frees cabins in ~2 min instead
  /// of waiting out the TTL. NULL = never reported (owner POS) and is NEVER
  /// reclaimed on the heartbeat rule — expiry alone governs those.
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz
  /// held / converted / released
  state       String   @default("held")

  cabin     HouseboatCabin @relation(fields: [cabinId], references: [id])
  departure TripDeparture  @relation(fields: [departureId], references: [id])
  heldByAccount Account?   @relation(fields: [heldBy], references: [id])

  @@index([departureId])
  @@index([expiresAt])
  @@index([heldByToken])
  @@index([lastSeenAt])
  // The every-minute sweeper filters state='held' AND (expiresAt<=now OR
  // lastSeenAt<stale). Leading with state keeps it off the released/converted
  // rows (holds are never deleted, only state-flipped, so the table only grows).
  @@index([state, expiresAt])
  @@index([state, lastSeenAt])
  @@map("cabin_hold")
}

/// Notified when a cabin frees; the link routes through a HOLD attempt so first-to-hold wins.
model BookingWaitlist {
  id          String   @id @db.Uuid
  departureId String   @map("departure_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  /// The specific cabin this customer is waiting for. NULL = any cabin on the
  /// trip, which is what every row created before per-cabin waitlisting means —
  /// those keep working untouched, and the owner/platform screens never read it.
  cabinId     String?  @map("cabin_id") @db.Uuid
  partySize   Int      @map("party_size")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  departure TripDeparture  @relation(fields: [departureId], references: [id])
  customer  Account        @relation(fields: [customerId], references: [id])
  cabin     HouseboatCabin? @relation(fields: [cabinId], references: [id])

  @@index([departureId])
  /// The notify lookup: "who is waiting on THIS cabin?"
  @@index([departureId, cabinId])
  /// One row per customer per cabin. Postgres treats NULLs as distinct, so
  /// legacy trip-level rows are not constrained against each other — join()
  /// still de-dupes those in code.
  @@unique([departureId, customerId, cabinId])
  @@map("booking_waitlist")
}

model QuoteRequest {
  id           String    @id @db.Uuid
  houseboatId  String    @map("houseboat_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  date         DateTime? @db.Date
  groupSize    Int?      @map("group_size")
  specialNeeds String?   @map("special_needs")
  /// null until owner prices it
  quotedPrice  Decimal?  @map("quoted_price") @db.Decimal(12, 2)
  /// requested / sent / accepted / expired
  status       String    @default("requested")
  /// customer's one-shot note back to the owner (after they see the price)
  customerReply String?  @map("customer_reply")
  /// 24h OR when the date fills, whichever first
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz

  houseboat Houseboat @relation(fields: [houseboatId], references: [id])
  customer  Account   @relation(fields: [customerId], references: [id])

  @@index([houseboatId])
  @@map("quote_request")
}

// ---------- MONEY: INVOICES, PAYMENTS, REFUNDS, PAYOUTS ----------

/// ONE invoice per booking, three party-views. See BILL ORDER in plan/houseboat_logic.md §1.
model Invoice {
  id             String   @id @db.Uuid
  bookingId      String   @unique @map("booking_id") @db.Uuid
  houseboatId    String   @map("houseboat_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  /// STEP 1: owner-set room price (sum of booking_cabin.room_price)
  roomTotal      Decimal  @map("room_total") @db.Decimal(12, 2)
  /// STEP 2: REMOVED — gateway fee no longer charged; always 0
  gatewayFee     Decimal  @default(0) @map("gateway_fee") @db.Decimal(12, 2)
  /// STEP 3: = room_total (no gateway fee added) — shown BEFORE any coupon
  priceShown     Decimal  @map("price_shown") @db.Decimal(12, 2)
  /// STEP 4: coupon applied LAST, to price_shown
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// STEP 5: price_shown - discount = what the customer pays
  displayTotal   Decimal  @map("display_total") @db.Decimal(12, 2)
  /// platform % of room_total (ORIGINAL, NOT discounted) — boat absorbs its own coupon
  commission     Decimal  @default(0) @db.Decimal(12, 2)
  dueToBoat      Decimal  @default(0) @map("due_to_boat") @db.Decimal(12, 2)
  amountPaid     Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  /// buyout adjusted below what was paid → becomes customer_credit or refund
  amountOverpaid Decimal  @default(0) @map("amount_overpaid") @db.Decimal(12, 2)
  /// cancellation policy agreed at checkout — cite in disputes
  policySnapshot Json?    @map("policy_snapshot")
  /// null until pulled into a weekly batch; setting it locks the invoice (in_payout)
  payoutBatchId  String?  @map("payout_batch_id") @db.Uuid
  /// see plan §4 state machine. LOCK to in_payout on batch entry.
  status         String   @default("customer_due")

  booking     Booking               @relation(fields: [bookingId], references: [id])
  houseboat   Houseboat             @relation(fields: [houseboatId], references: [id])
  customer    Account               @relation(fields: [customerId], references: [id])
  payoutBatch HouseboatPayoutBatch? @relation(fields: [payoutBatchId], references: [id])
  payments    InvoicePayment[]
  refunds     InvoiceRefund[]
  creditsFrom CustomerCredit[]      @relation("CreditSource")
  creditsUsed CustomerCredit[]      @relation("CreditUsed")

  @@index([houseboatId])
  @@index([customerId])
  @@index([status])
  // The platform verify/payout queues filter status + payoutBatchId IS NULL and
  // scan the whole invoice set as GMV grows; this composite serves them.
  @@index([status, payoutBatchId])
  @@map("invoice")
}

model InvoicePayment {
  id           String   @id @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  /// gateway (legacy/customer) / cash / bkash / bank / online — owner collection channels
  method       String
  /// unique-indexed → webhook replay is a no-op
  gatewayToken String?  @unique @map("gateway_token")
  /// who marked a cash payment
  receivedBy   String?  @map("received_by") @db.Uuid
  /// finance for gateway; boat manager for cash
  verifiedBy   String?  @map("verified_by") @db.Uuid
  paidAt       DateTime? @map("paid_at") @db.Timestamptz

  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  receivedByAccount Account? @relation("PaymentReceivedBy", fields: [receivedBy], references: [id])
  verifiedByAccount Account? @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id])

  @@index([invoiceId])
  @@map("invoice_payment")
}

/// Only reachable when the OWNER cancelled the trip, within 6 days. Customer-cancel refunds follow policy template.
model InvoiceRefund {
  id            String    @id @db.Uuid
  invoiceId     String    @map("invoice_id") @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  reason        String?
  /// ENCRYPT at rest; collected only after owner-cancel
  bankDetails   Json?     @map("bank_details")
  requestedBy   String?   @map("requested_by") @db.Uuid
  verifiedBy    String?   @map("verified_by") @db.Uuid
  /// separation of duties: not the same person as verified_by
  completedBy   String?   @map("completed_by") @db.Uuid
  /// requested / verified / completed
  status        String    @default("requested")
  /// who raised it: 'owner' = owner/finance-raised (POS or owner-cancel), strict 3-person duties;
  /// 'customer' = customer-raised web refund, one admin may verify+complete
  origin        String    @default("owner")
  /// 6 days from owner cancellation; after this the refund button disappears.
  /// NULL for customer-origin refunds — their window is enforced at request time, not on admin steps.
  claimDeadline DateTime? @map("claim_deadline") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  requestedByAccount Account? @relation("RefundRequestedBy", fields: [requestedBy], references: [id])
  verifiedByAccount  Account? @relation("RefundVerifiedBy", fields: [verifiedBy], references: [id])
  completedByAccount Account? @relation("RefundCompletedBy", fields: [completedBy], references: [id])

  @@index([invoiceId])
  @@map("invoice_refund")
}

model HouseboatPayoutBatch {
  id          String    @id @db.Uuid
  houseboatId String    @map("houseboat_id") @db.Uuid
  /// SIGNED — can be negative if the boat owes the platform
  totalAmount Decimal   @map("total_amount") @db.Decimal(12, 2)
  preparedBy  String?   @map("prepared_by") @db.Uuid
  /// legacy 2-person flow: was required to differ from prepared_by (constraint
  /// dropped — one finance member now runs the whole flow)
  approvedBy  String?   @map("approved_by") @db.Uuid
  /// prepared / approved / paid. The new "Pay to Vendors" flow creates rows
  /// already 'paid' (as receipts); prepared/approved are the legacy batch path.
  status      String    @default("prepared")
  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  /// who confirmed the vendor payment (new invoice-level flow); receipt actor
  paidBy      String?   @map("paid_by") @db.Uuid
  /// snapshot of the boat's bank_account at pay time, so a later edit to the
  /// boat's details never changes a historical payout receipt
  bankSnapshot Json?    @map("bank_snapshot")

  houseboat Houseboat @relation(fields: [houseboatId], references: [id])
  preparedByAccount Account? @relation("PayoutPreparedBy", fields: [preparedBy], references: [id])
  approvedByAccount Account? @relation("PayoutApprovedBy", fields: [approvedBy], references: [id])
  paidByAccount     Account? @relation("PayoutPaidBy", fields: [paidBy], references: [id])
  invoices  Invoice[]

  @@index([houseboatId])
  @@map("houseboat_payout_batch")
}

model CancellationPolicy {
  id             String  @id @db.Uuid
  houseboatId    String  @map("houseboat_id") @db.Uuid
  /// flexible / moderate / strict / non_refundable / custom
  policyTemplate String  @map("policy_template")
  depositPct     Int?    @map("deposit_pct")
  shownAtCheckout Boolean @default(true) @map("shown_at_checkout")
  /// custom tiers + blackout dates: [{days_before,refund_pct,is_blackout}]
  tiers          Json?

  houseboat    Houseboat     @relation(fields: [houseboatId], references: [id])
  tripPackages TripPackage[]

  @@index([houseboatId])
  @@map("cancellation_policy")
}

model Coupon {
  id          String    @id @db.Uuid
  houseboatId String    @map("houseboat_id") @db.Uuid
  code        String
  /// percent / flat / referral
  kind        String
  value       Decimal   @db.Decimal(12, 2)
  validFrom   DateTime? @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  /// Total redemptions allowed across all customers. null = unlimited (legacy default).
  maxUses     Int?      @map("max_uses")
  /// Redemptions allowed per customer account. null = unlimited.
  perUserLimit Int?     @map("per_user_limit")
  /// Minimum room total (price_shown) required to apply the coupon. null = no minimum.
  minSpend    Decimal?  @map("min_spend") @db.Decimal(12, 2)

  houseboat Houseboat @relation(fields: [houseboatId], references: [id])
  bookings  Booking[]

  @@unique([houseboatId, code])
  @@index([houseboatId])
  @@index([code])
  @@map("coupon")
}

/// A checkout that is priced and awaiting its deposit (audit M-H2). The booking
/// is NOT created until a valid deposit (>= the required percent of the bill)
/// is confirmed — until then the cabins stay reserved only by their live holds.
/// The full checkout request is snapshotted here so the async gateway IPN can
/// build the booking on confirmation. Consumed (status='consumed') exactly once;
/// expires with the holds so an abandoned intent self-cleans.
/// Idempotency ledger for offline-sync replay (audit #7 / F19). One row per
/// applied offline intent, keyed by the client-generated intentId. The replay
/// engine INSERTs the claim BEFORE applying the action; the unique PK makes a
/// duplicate or concurrent replay fail atomically (P2002 → 'duplicate'), which
/// the append-only audit_log (partitioned on server_time, so it cannot carry a
/// unique index on intentId) cannot do on its own.
model SyncIntentApplied {
  intentId    String   @id @map("intent_id")
  accountId   String   @map("account_id") @db.Uuid
  houseboatId String   @map("houseboat_id") @db.Uuid
  action      String
  appliedAt   DateTime @default(now()) @map("applied_at") @db.Timestamptz

  @@map("sync_intent_applied")
}

model BookingIntent {
  id           String   @id @db.Uuid
  departureId  String   @map("departure_id") @db.Uuid
  houseboatId  String   @map("houseboat_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  bookedBy     String   @map("booked_by") @db.Uuid
  channel      String   @default("web")
  /// The validated CheckoutDto (cabins, guest, coupon, useCredit, …) as JSON.
  payload      Json
  /// Snapshot of the priced bill total the deposit floor is measured against.
  displayTotal Decimal  @map("display_total") @db.Decimal(12, 2)
  /// Full priced bill breakdown (roomTotal/gatewayFee/priceShown/discountAmount/
  /// displayTotal/commission) captured at createIntent, so confirmIntent bills the
  /// customer exactly the price they saw at checkout even if the owner changed
  /// pricing in between (audit #10/F12). Nullable: legacy intents re-price.
  billSnapshot Json?    @map("bill_snapshot")
  /// Minimum deposit that must be paid to convert this intent into a booking.
  minDeposit   Decimal  @map("min_deposit") @db.Decimal(12, 2)
  /// requested / consumed / expired
  status       String   @default("requested")
  bookingId    String?  @map("booking_id") @db.Uuid
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([departureId])
  @@index([customerId])
  @@index([status])
  @@map("booking_intent")
}

/// Platform-set per boat. Commission AND monthly can both apply. Billing PER BOAT.
model HouseboatBillingConfig {
  id             String    @id @db.Uuid
  houseboatId    String    @map("houseboat_id") @db.Uuid
  /// null if not on commission
  commissionPct  Decimal?  @map("commission_pct") @db.Decimal(5, 2)
  /// null if not on monthly
  monthlyFee     Decimal?  @map("monthly_fee") @db.Decimal(12, 2)
  /// DEPRECATED — gateway fee removed platform-wide; column kept, no longer read or written
  gatewayFeePct  Decimal?  @map("gateway_fee_pct") @db.Decimal(5, 2)
  /// SIGNED. Negative = boat owes platform. If exceeded, access denied until settled.
  platformBalance Decimal  @default(0) @map("platform_balance") @db.Decimal(12, 2)
  trialEnds      DateTime? @map("trial_ends") @db.Date

  houseboat            Houseboat                      @relation("BillingConfigOwner", fields: [houseboatId], references: [id])
  houseboatsUsing      Houseboat[]                    @relation("HouseboatBillingConfig")
  subscriptionInvoices HouseboatSubscriptionInvoice[]

  @@index([houseboatId])
  @@map("houseboat_billing_config")
}

/// The monthly bill the PLATFORM sends the boat — separate from booking-commission invoices.
model HouseboatSubscriptionInvoice {
  id              String   @id @db.Uuid
  houseboatId     String   @map("houseboat_id") @db.Uuid
  billingConfigId String   @map("billing_config_id") @db.Uuid
  period          String
  monthlyFee      Decimal? @map("monthly_fee") @db.Decimal(12, 2)
  amountDue       Decimal  @map("amount_due") @db.Decimal(12, 2)
  /// issued / paid / overdue
  status          String   @default("issued")
  issuedAt        DateTime @default(now()) @map("issued_at") @db.Timestamptz

  houseboat     Houseboat              @relation(fields: [houseboatId], references: [id])
  billingConfig HouseboatBillingConfig @relation(fields: [billingConfigId], references: [id])

  @@index([houseboatId])
  @@map("houseboat_subscription_invoice")
}

/// Records money a shareholder actually withdrew. No auto-split — just the record.
model OwnerDistribution {
  id           String   @id @db.Uuid
  houseboatId  String   @map("houseboat_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  note         String?
  recordedBy   String?  @map("recorded_by") @db.Uuid
  at           DateTime @default(now()) @db.Timestamptz

  houseboat  Houseboat       @relation(fields: [houseboatId], references: [id])
  membership HouseboatMember @relation(fields: [membershipId], references: [id])
  recordedByAccount Account? @relation(fields: [recordedBy], references: [id])

  @@index([houseboatId])
  @@map("owner_distribution")
}

/// Home for buyout overpayments — credit toward a future booking.
model CustomerCredit {
  id              String  @id @db.Uuid
  accountId       String  @map("account_id") @db.Uuid
  sourceInvoiceId String? @map("source_invoice_id") @db.Uuid
  amount          Decimal @db.Decimal(12, 2)
  /// refund (cancellation payout to the customer) / rebate (open-seat surplus).
  /// Drives the boat-payout subtraction (audit M-M1): a spent refund still
  /// reduces the boat's due; a rebate never does (it already cut displayTotal).
  /// null on legacy rows → treated as refund-with-prior-behavior.
  kind            String? @map("kind")
  /// null until spent
  usedInInvoiceId String? @map("used_in_invoice_id") @db.Uuid
  /// open / used / pending_cashout. `pending_cashout` credits are locked against an
  /// open CashoutRequest: excluded from the wallet balance AND from applyCredits(),
  /// so they can't be spent on a booking until finance approves (→ used) or rejects
  /// (→ back to open).
  status          String  @default("open")
  /// The cash-out request that locked this credit (set when status → pending_cashout,
  /// cleared when it returns to open). Scopes resolve so approving one request only
  /// touches ITS credits, never every pending_cashout credit on the account.
  cashoutRequestId String? @map("cashout_request_id") @db.Uuid

  account       Account  @relation(fields: [accountId], references: [id])
  sourceInvoice Invoice? @relation("CreditSource", fields: [sourceInvoiceId], references: [id])
  usedInInvoice Invoice? @relation("CreditUsed", fields: [usedInInvoiceId], references: [id])
  cashoutRequest CashoutRequest? @relation(fields: [cashoutRequestId], references: [id])

  @@index([accountId])
  @@index([cashoutRequestId])
  @@map("customer_credit")
}

/// A customer's request to withdraw their open wallet balance to bKash/Nagad/bank.
/// Created for the full open balance; the account's `open` credits are moved to
/// `pending_cashout` at request time so the money is locked from booking use.
/// Finance approves (credits → used) or rejects (credits → open) from the console.
model CashoutRequest {
  id                  String    @id @db.Uuid
  accountId           String    @map("account_id") @db.Uuid
  amount              Decimal   @db.Decimal(12, 2)
  /// bkash / nagad / bank
  method              String
  /// bKash/Nagad number, or bank account number
  accountRef          String    @map("account_ref")
  /// only for method = bank
  bankName            String?   @map("bank_name")
  /// pending / approved / rejected
  status              String    @default("pending")
  note                String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz
  resolvedByAccountId String?   @map("resolved_by_account_id") @db.Uuid

  account          Account  @relation("CashoutRequester", fields: [accountId], references: [id])
  resolvedByAccount Account? @relation("CashoutResolvedBy", fields: [resolvedByAccountId], references: [id])
  lockedCredits     CustomerCredit[]

  @@index([accountId])
  @@index([status])
  @@map("cashout_request")
}

// ---------- HR: STAFF, CREW, PAYROLL ----------

model HouseboatStaff {
  id               String   @id @db.Uuid
  /// links to a login
  accountId        String   @map("account_id") @db.Uuid
  houseboatId      String   @map("houseboat_id") @db.Uuid
  roleId           String?  @map("role_id") @db.Uuid
  /// job title (sukani, cook, helper…) — NOT the RBAC role relation
  designation      String?
  nid              String?
  emergencyContact String?  @map("emergency_contact")
  address          String?
  /// available / on_leave — kept in sync with the latest StaffLeave
  status           String   @default("available")
  /// own rate — a sukani is not paid like a cleaner
  perTripRate      Decimal? @map("per_trip_rate") @db.Decimal(12, 2)
  /// set instead of per_trip_rate for salaried staff
  monthlySalary    Decimal? @map("monthly_salary") @db.Decimal(12, 2)

  account   Account   @relation(fields: [accountId], references: [id])
  houseboat Houseboat @relation(fields: [houseboatId], references: [id])
  role      Role?     @relation(fields: [roleId], references: [id])
  tripCrew  TripCrew[]
  leaves    StaffLeave[]
  payroll   StaffPayroll[]

  @@index([houseboatId])
  @@index([accountId])
  @@map("houseboat_staff")
}

/// Auto-filled from houseboat.default_crew; owner edits only when someone differs that day.
model TripCrew {
  id          String  @id @db.Uuid
  departureId String  @map("departure_id") @db.Uuid
  staffId     String  @map("staff_id") @db.Uuid
  /// attendance = this row existing + present flag
  present     Boolean @default(true)

  departure TripDeparture  @relation(fields: [departureId], references: [id])
  staff     HouseboatStaff @relation(fields: [staffId], references: [id])

  @@unique([departureId, staffId])
  @@map("trip_crew")
}

model StaffLeave {
  id       String    @id @db.Uuid
  staffId  String    @map("staff_id") @db.Uuid
  /// on_leave / available / other_duty — NOT the same as "not assigned today"
  state    String
  fromDate DateTime? @map("from_date") @db.Date
  toDate   DateTime? @map("to_date") @db.Date
  note     String?

  staff HouseboatStaff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@map("staff_leave")
}

/// Full payment history is kept — owners need to know who has and has not been paid.
model StaffPayroll {
  id          String    @id @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  period      String
  tripsWorked Int?      @map("trips_worked")
  /// per_trip_rate × trips_worked, or monthly_salary
  baseAmount  Decimal   @map("base_amount") @db.Decimal(12, 2)
  bonus       Decimal   @default(0) @db.Decimal(12, 2)
  deduction   Decimal   @default(0) @db.Decimal(12, 2)
  /// base + bonus - deduction
  totalAmount Decimal   @map("total_amount") @db.Decimal(12, 2)
  /// owner tracks whether the wage was actually handed over
  paid        Boolean   @default(false)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  paidBy      String?   @map("paid_by") @db.Uuid

  staff         HouseboatStaff @relation(fields: [staffId], references: [id])
  paidByAccount Account?       @relation(fields: [paidBy], references: [id])

  @@index([staffId])
  @@map("staff_payroll")
}

// ---------- OPS: COSTS, INVENTORY, REPORTING ----------

/// The spreadsheet-killer. One row, faster than a sheet. Accept Bangla numerals at the input layer.
model Cost {
  id          String   @id @db.Uuid
  houseboatId String   @map("houseboat_id") @db.Uuid
  date        DateTime @db.Date
  /// free text — no forced category. Bazar, fuel, repair…
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  /// optional — link to a trip or leave null
  tripId      String?  @map("trip_id") @db.Uuid
  /// auto-captured from the logged-in user
  paidBy      String?  @map("paid_by") @db.Uuid
  /// free-text note attached to the cost — separate from `description`
  comment     String?  @map("comment")

  houseboat     Houseboat      @relation(fields: [houseboatId], references: [id])
  trip          TripDeparture? @relation(fields: [tripId], references: [id])
  paidByAccount Account?       @relation(fields: [paidBy], references: [id])

  @@index([houseboatId])
  @@index([date])
  @@map("cost")
}

model InventoryItem {
  id               String   @id @db.Uuid
  houseboatId      String   @map("houseboat_id") @db.Uuid
  name             String
  /// consumable (reorder alert) / durable (missing-item check)
  kind             String
  unit             String?
  /// consumables — flag when below
  reorderThreshold Decimal? @map("reorder_threshold") @db.Decimal(12, 2)
  currentQty       Decimal  @default(0) @map("current_qty") @db.Decimal(12, 2)

  houseboat Houseboat       @relation(fields: [houseboatId], references: [id])
  movements StockMovement[]

  @@index([houseboatId])
  @@map("inventory_item")
}

/// Durable counts are run by the OWNER whenever they choose — not automatically after every trip.
model StockMovement {
  id              String   @id @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  tripId          String?  @map("trip_id") @db.Uuid
  /// in / out / count
  direction       String
  qty             Decimal  @db.Decimal(12, 2)
  /// for a count: what the system believed was there
  expectedQty     Decimal? @map("expected_qty") @db.Decimal(12, 2)
  /// expected - actual; anything above zero is missing
  discrepancy     Decimal? @db.Decimal(12, 2)
  /// auto from login
  loggedBy        String?  @map("logged_by") @db.Uuid
  at              DateTime @default(now()) @db.Timestamptz

  item          InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  trip          TripDeparture? @relation(fields: [tripId], references: [id])
  loggedByAccount Account?     @relation(fields: [loggedBy], references: [id])

  @@index([inventoryItemId])
  @@map("stock_movement")
}

/// A maintenance request / ticket raised against the boat.
model MaintenanceRequest {
  id          String    @id @db.Uuid
  houseboatId String    @map("houseboat_id") @db.Uuid
  topic       String
  /// low | medium | high
  urgency     String    @default("medium")
  /// pending | in_progress | complete | canceled
  status      String    @default("pending")
  /// when the work is scheduled/needed — date + time of day
  requestedAt DateTime  @map("requested_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// stamped when the request moves to complete/canceled
  closedAt    DateTime? @map("closed_at") @db.Timestamptz

  houseboat Houseboat                   @relation(fields: [houseboatId], references: [id])
  comments  MaintenanceRequestComment[]

  @@index([houseboatId])
  @@map("maintenance_request")
}

/// A comment on a request; also records the status transition it accompanied.
model MaintenanceRequestComment {
  id           String   @id @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  body         String
  /// status this comment accompanied, e.g. "in_progress"; null for a plain note
  statusChange String?  @map("status_change")
  authorId     String?  @map("author_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("maintenance_request_comment")
}

/// Only from verified completed bookings.
model Review {
  id          String  @id @db.Uuid
  bookingId   String  @unique @map("booking_id") @db.Uuid
  houseboatId String  @map("houseboat_id") @db.Uuid
  customerId  String  @map("customer_id") @db.Uuid
  rating      Int
  text        String?
  ownerReply  String? @map("owner_reply")
  /// Platform moderation: a hidden review is withheld from public listings and
  /// rating aggregates. Default false — reviews are visible until an admin hides one.
  hidden      Boolean @default(false)

  booking   Booking   @relation(fields: [bookingId], references: [id])
  houseboat Houseboat @relation(fields: [houseboatId], references: [id])
  customer  Account   @relation(fields: [customerId], references: [id])

  @@index([houseboatId])
  @@map("review")
}

model Notification {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  /// booking, payment_due, refund_sent, low_stock, offer…
  event     String
  /// sms / email
  channel   String
  delivered Boolean  @default(false)
  /// when the customer marked this read in their account inbox; NULL = unread
  readAt    DateTime? @map("read_at") @db.Timestamptz
  /// minimal replay payload for console resend: {phone?, email?, subject?, html?, message?, bookingId?}.
  /// NULL = row predates this column and cannot be resent.
  payload   Json?
  /// automated-retry bookkeeping (delivered:false rows only). See NotificationRetryService.
  attemptCount  Int       @default(0) @map("attempt_count")
  /// when the retry cron may next attempt this row; NULL = not scheduled (delivered, or gave up).
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz
  at        DateTime @default(now()) @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  // Inbox/history reads WHERE accountId ORDER BY at DESC. Notification is the
  // fastest-growing table (one row per send); this serves the ordered read.
  @@index([accountId, at(sort: Desc)])
  // The retry cron scans WHERE delivered=false AND nextAttemptAt <= now.
  @@index([delivered, nextAttemptAt])
  @@map("notification")
}

model HouseboatMedia {
  id          String  @id @db.Uuid
  houseboatId String  @map("houseboat_id") @db.Uuid
  /// optional: media belongs to a specific cabin's gallery (else boat-level)
  cabinId     String? @map("cabin_id") @db.Uuid
  /// image | video
  kind        String
  /// image only: object key in the Cloudflare R2 bucket. public URL is
  /// storage.publicBaseUrl + key. null for videos.
  storageKey  String? @map("storage_key")
  /// video only: canonical provider URL (rebuilt server-side, never raw input).
  /// null for images.
  videoUrl      String? @map("video_url")
  /// video only: allowlisted provider — youtube | vimeo | google_drive |
  /// facebook | instagram. null for images.
  videoProvider String? @map("video_provider")
  /// display order within the gallery
  sortOrder   Int     @default(0) @map("sort_order")
  uploadedBy  String? @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  houseboat Houseboat      @relation(fields: [houseboatId], references: [id])
  cabin     HouseboatCabin? @relation(fields: [cabinId], references: [id])

  @@index([houseboatId])
  @@index([cabinId])
  @@map("houseboat_media")
}
