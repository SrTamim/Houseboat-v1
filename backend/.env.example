# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# API docs at /api/docs. On by default in dev; set true to expose in prod.
SWAGGER_ENABLED=false
# Public URL of the frontend, for CORS + cookie domain + e-ticket links
WEB_ORIGIN=http://localhost:3000

# ── Database (PostgreSQL / Supabase in prod) ──────────
# Local: your own Postgres. Prod: Supabase — use the connection-pooler URL and
# append ?sslmode=require&pgbouncer=true.
#
# Use a NON-SUPERUSER role at runtime. A superuser bypasses every GRANT and can
# DROP TRIGGER trg_audit_no_update — the sole enforcement of the append-only
# audit log. Provision the runtime role with CRUD on the app schema and no DDL:
#
#   CREATE ROLE houseboat_app LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE houseboat TO houseboat_app;
#   GRANT USAGE ON SCHEMA public TO houseboat_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO houseboat_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO houseboat_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public
#     GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO houseboat_app;
#
# In production append connection + TLS params, e.g.
#   ?schema=public&sslmode=require&connection_limit=10&pool_timeout=20
# connection_limit matters because Prisma defaults to (cpus*2+1) connections
# PER INSTANCE — a few autoscaled replicas can exhaust Postgres' max_connections
# and lock everyone out. sslmode=require prevents credentials crossing the
# network in the clear.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/houseboat?schema=public

# Migration/owner role. `prisma migrate deploy` and `prisma db push` need DDL,
# which the runtime role above deliberately lacks. Also used as Prisma's
# directUrl, so a pooled DATABASE_URL (pgbouncer) doesn't break migrations.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/houseboat?schema=public

# ── Redis (cache + rate-limit + hold-sweeper coordination) ─
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=30d
CSRF_SECRET=change-me-32-bytes-min
# App-layer PII encryption (refund bank details). 32+ chars in production.
ENCRYPTION_KEY=change-me-32-bytes-min
# MUST be true in production (cookies only sent over HTTPS). Startup fails otherwise.
COOKIE_SECURE=false

# ── Platform admin seed (pnpm db:seed) ────────────────
# Seeded in a maker/checker pair: refunds and payouts enforce separation of
# duties (one is a DB CHECK constraint), so a single admin cannot complete
# those flows. The seed refuses to run if these are unset — no default password.
ADMIN_PHONE=+8801700000000
ADMIN_PASSWORD=change-me-local-only
ADMIN2_PHONE=+8801700000001
ADMIN2_PASSWORD=change-me-local-only

# Demo boat owner (owner console login). Same no-default policy as the admins.
OWNER_PHONE=+8801700000002
OWNER_PASSWORD=change-me-local-only

# ── Object storage ────────────────────────────────────
# 'local' (default) writes uploads to STORAGE_LOCAL_DIR and serves them at
# /uploads — zero config, for dev. Set 'r2' in deploy to use Cloudflare R2
# (fill in the S3_* keys below). No API/frontend changes to switch.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads

# ── Cloudflare R2 (S3-compatible) — used when STORAGE_DRIVER=r2 ─
# Endpoint: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=houseboat
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket / CDN base for serving images, e.g. https://media.yourdomain.com
S3_PUBLIC_BASE_URL=

# ── Web Push (VAPID) ──────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Public URLs (gateway redirects, IPN, e-ticket links) ──
API_PUBLIC_URL=http://localhost:4000

# ── Payment gateway (SSLCommerz — Bangladesh) ─────────────
GATEWAY_PROVIDER=sslcommerz
# true = SSLCommerz sandbox host + test store. Set false for live.
SSLCZ_SANDBOX=true
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
# Confirm bookings WITHOUT taking money, while the gateway is unconfigured.
# Enables POST /api/gateway/sslcommerz/dev/settle, which records a real payment
# and marks the invoice paid — those bookings show up in owner payouts and
# finance reports as genuine revenue, so clear them before going live.
# Anything other than the exact string "true" leaves it OFF (403 on every call).
PAYMENTS_BYPASS=false

# ── Notifications: SMS (BD) + Email (SMTP) ────────────────
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMTP_URL=
EMAIL_FROM=no-reply@houseboat.local
